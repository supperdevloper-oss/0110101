# Web/API server
PORT=3001
SESSION_SECRET=
# Production site origin. Override to http://localhost:5173 for local development.
APP_URL=https://imagepromptify.xyz

# OpenAI API — required for live prompt and image generation; keys stay server-side.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
# Optional compatible image-generation endpoint for the site-specific Flux/Imagen/Nano Banana choices.
# Expected JSON response: { "image": "https://..." } or { "data": [{ "b64_json": "..." }] }
IMAGE_GENERATION_API_URL=
IMAGE_GENERATION_API_KEY=

# Optional Google OAuth sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Google OAuth redirect URI; use localhost:3001 for local development.
GOOGLE_CALLBACK_URL=https://imagepromptify.xyz/api/oauth/google/callback

# Optional Stripe Checkout. Configure the matching Stripe Price IDs in Stripe.
STRIPE_SECRET_KEY=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_ULTIMATE_MONTHLY=
STRIPE_PRICE_ULTIMATE_ANNUAL=
STRIPE_PRICE_IMAGE_PACK_STANDARD=
STRIPE_PRICE_IMAGE_PACK_PRO=
STRIPE_PRICE_IMAGE_PACK_MAX=
STRIPE_PRICE_PROMPT_PACK=

# Optional feedback delivery webhook; if unset, the form reports that delivery is not configured.
CONTACT_WEBHOOK_URL=

# `ffmpeg` must be installed and available on PATH for Video to Prompt analysis.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
